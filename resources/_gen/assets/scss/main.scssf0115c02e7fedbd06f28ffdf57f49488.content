.skip-link{position:absolute;top:-100%;left:0;background:#252220;color:#ede6dd;padding:.5rem 1rem;z-index:9999;text-decoration:none}.skip-link:focus{top:0}body{-webkit-font-smoothing:antialiased;margin:0;font-family:-apple-system,BlinkMacSystemFont,helvetica neue,Arial,sans-serif;font-size:1rem;line-height:1.6;color:#cec6bc;background:#1a1816}header a,footer a,main a{text-decoration:none}a.post.post--draft{border:1px dashed #c8804a;border-radius:8px;background:rgba(200,128,74,8%)}a.post.post--draft .post-title{color:#c8804a}a.post{gap:1rem;align-items:center;border:1px solid transparent;display:grid;grid-template-columns:auto 60px;margin:0 -1rem;padding:.4rem 1rem;color:#cec6bc}a.post:hover{border-color:#4a4540;border-radius:8px;background:rgba(255,255,255,5%);color:#ede6dd}a.post:hover .post-title{color:#ede6dd}a.post .post-title{color:#cec6bc;display:grid;font-size:1.2rem;margin:0}a.post .post-day{display:block;font-size:.8rem;font-weight:400;text-align:center}ul.posts,ul.notes{list-style:none;margin:0;padding:0}ul.posts li,ul.notes li{display:block}h1,h2,h3{margin:0 0 1.5rem;line-height:1.2;color:#c8804a;scroll-margin-top:80px;font-weight:600}h3{color:#a88060;font-weight:500}h2:not(:first-child),h3:not(:first-child){margin-top:3rem}header ul,footer ul{padding:0;list-style:none}header ul li,footer ul li{display:inline}header{position:fixed;top:0;left:0;width:100%;background:#252220;border-bottom:1px solid #2e2b28;height:60px;z-index:2000;box-sizing:border-box;display:flex;align-items:center;font-weight:600;padding:0 1.5rem;justify-content:space-between}header a{color:#cec6bc;padding:.5rem;border-radius:8px;font-size:.9rem}header a:hover{color:#ede6dd;background:#332e2b}header .menu{text-align:center}header img{max-height:20px;max-width:25px;margin:0 5px 5px 0}.container,.prevnext{margin:0 auto;max-width:850px;padding:1rem}main{margin-top:60px;min-height:calc(100vh - 145px)}main article a,main .prevnext a{border-bottom:1px solid #d4a87a;color:#d4a87a}main article a:hover,main .prevnext a:hover{color:#c8804a;border-bottom-color:#c8804a}main article h1,main .prevnext h1{font-size:2.5rem;font-weight:700;margin-bottom:.5rem;color:#ede6dd}main article h2,main article h3,main .prevnext h2,main .prevnext h3{margin:0 0 1.25rem}main article h2,main .prevnext h2{font-size:1.9rem;padding-bottom:.25rem}main article h3,main .prevnext h3{font-size:1.75rem}main article blockquote,main article ol,main article p,main article ul,main .prevnext blockquote,main .prevnext ol,main .prevnext p,main .prevnext ul{margin:0 0 2rem}main article .main-header,main .prevnext .main-header{display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid #4a4540}main article .main-header a,main .prevnext .main-header a{font-size:1rem}footer{width:100%;background:#252220;border-top:1px solid #2e2b28;padding:1rem 0;box-sizing:border-box;align-items:center;display:flex;flex-direction:column;gap:.5rem}footer a{color:#cec6bc}footer a:hover{color:#ede6dd;background:#332e2b}footer ul{margin:0}footer ul li{padding:.25rem 1rem}footer .copyright{display:inline-block;font-size:.7rem}footer .copyright a{border-bottom:1px solid #cec6bc}img{margin:0 auto 2rem;max-width:100%;height:auto;vertical-align:bottom;border-radius:12px}figure{display:table;margin:0 auto}figure img.with-caption{margin-bottom:0}figure figcaption{display:table-caption;caption-side:bottom;margin:.5em 1em 2em;font-size:.8rem;text-align:center}.home .hero{padding:2rem 0 0;text-align:left}.home .hero .container{font-size:1.3rem}.home .hero .container .content{align-items:center;display:flex;justify-content:space-between}.home .hero .container .content h1{color:#ede6dd;font-size:3rem;margin-bottom:1.5rem}.home .hero .container .content img{height:auto;margin-left:2rem;width:225px}@media screen and (max-width:710px){header,footer{padding-left:.2rem;padding-right:.2rem;font-size:.7rem}header a,footer a{padding:.2rem .4rem}header img,footer img{display:none}footer .copyright{text-align:center}footer ul li{padding:0}.home .content-search form,.page .content-search form{grid-template-columns:auto}.home main .hero,.page main .hero{padding:0}.home main .hero .container .content,.page main .hero .container .content{align-items:flex-start;flex-direction:column;display:flex}.home main .hero .container .content .intro,.page main .hero .container .content .intro{order:2}.home main .hero .container .content .intro h1,.page main .hero .container .content .intro h1{font-size:1.5rem;margin-bottom:1rem}.home main .hero .container .content .intro p,.page main .hero .container .content .intro p{font-size:1rem}.home main .hero .container .content img,.page main .hero .container .content img{order:1;max-width:50%;margin:0 auto 1.5rem}.home main article .content-header,.page main article .content-header{padding:0 0 2rem}.home main article .content-header .meta,.page main article .content-header .meta{padding:.4rem 0}.home main article a.post h3,.page main article a.post h3{font-size:1rem}.home main article h1,.page main article h1{font-size:1.8rem}.home main article h2,.page main article h2{font-size:1.5rem}.home main article .content p,.home main article .content ol,.home main article .content ul,.home main article .content table,.home main article .content blockquote,.page main article .content p,.page main article .content ol,.page main article .content ul,.page main article .content table,.page main article .content blockquote{font-size:1.2rem;margin:0 0 1.5rem}.home main .description,.page main .description{font-size:1rem}}